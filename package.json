{
    "name": "python-debug-sync",
    "displayName": "Python Debug Config Sync",
    "description": "Sync VS Code Python debug configs to IntelliJ",
    "version": "1.0.0",
    "repository": {},
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:python"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "pythonDebugSync.sync",
                "title": "Sync Python Debug Configs to IntelliJ"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "test": "npm run compile && npx mocha out/src/test/suite/*.test.js",
        "test:integration": "node ./src/test/runTest.js",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/mocha": "^9.0.0",
        "@types/node": "16.x",
        "@types/vscode": "^1.60.0",
        "jsonc-parser": "^3.2.0",
        "mocha": "^9.0.0",
        "ts-node": "^10.0.0",
        "typescript": "^4.9.0",
        "vsce": "^2.0.0"
    },
    "dependencies": {
        "@vscode/test-electron": "^2.5.2"
    }
}
